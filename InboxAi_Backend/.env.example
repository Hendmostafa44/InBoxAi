# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://inboxai.fastapicloud.dev/auth/google/callback

# Frontend redirect after successful login
FRONTEND_URL=https://in-box-ai.vercel.app/

# Comma-separated browser origins allowed by the API
ALLOWED_ORIGINS=https://in-box-ai.vercel.app,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173

# Database
SUPABASE_DB_USER=your_database_user
SUPABASE_DB_PASSWORD=your_database_password
SUPABASE_DB_HOST=your_database_host
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres

# AI provider configuration
GOOGLE_API_KEY=your_google_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
